# ─── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=0
# Only needed if the frontend runs on a different origin than the API (comma separated)
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  copy MONGODB_URI from your atlas-credentials.env and add the database name, e.g.
#         mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ─── Admin auth ────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# The first admin account is created from these on first start (only if no admin exists yet).
# Change the password from Admin -> Settings after your first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# ─── GitHub sync (optional) ────────────────────────────────
# Optional; raises the GitHub API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# ─── Email notification for new contact messages (optional) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
